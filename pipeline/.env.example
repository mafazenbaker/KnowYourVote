# KnowYourVote data pipeline — API keys
# Copy this file to pipeline/.env and fill in your own free keys.
# pipeline/.env is gitignored — never commit real keys.

# Congress.gov API (federal legislators + legislation).
# Get a free key instantly: https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# OpenStates / Plural API (state legislators + bills).
# Get a free key: https://openstates.org/accounts/signup/
OPENSTATES_API_KEY=
